# base/gitconfig.base — universal git settings + identity routing.
#
# Your name and email come from your identity: install.sh writes
# ~/.gitconfig.identity, which includes identities/<id>/gitconfig (see
# identities/example/gitconfig). A second identity for some repos (work, a
# client) is routed by remote URL with [includeIf "hasconfig:remote.*.url:..."]
# blocks, so no per-repo `git config user.email` is needed (example below).
#
# Machine-local overrides still apply via [include] path = ~/.gitconfig.local.

; credential.helper is OS-specific (osxkeychain on macOS, store/libsecret
; on Linux) and belongs in ~/.gitconfig.local. Keeping it out of this
; universal config prevents the "git: 'credential-osxkeychain' is not a git
; command" warning on Linux.
[core]
	autocrlf = input
	; Universal git hooks shared across every repo (base/git/hooks): pre-commit
	; scans the staged diff with gitleaks and runs the repo's own pre-commit
	; suite; pre-push scans the outgoing commits with gitleaks, fail-closed.
	; git never looks in .git/hooks while core.hooksPath is set, so every client
	; hook here runs the repo's own one of the same name (or Git LFS's, in an LFS
	; repo) through run-repo-hook; pre-commit runs a .pre-commit-config.yaml
	; suite instead when the repo has one.
	;
	; MUST stay `~`-relative, never an absolute home path: git SILENTLY skips a
	; hooksPath that does not exist, so a path that is right on one machine and
	; missing on another turns the fail-closed pre-push scan into a no-op there.
	; Test after changing this with `git config --path core.hooksPath` — it must
	; print an existing directory.
	hooksPath = ~/.dotfiles/base/git/hooks
[push]
	autoSetupRemote = true
[alias]
	# Custom status/log helpers
	s = "!git status -sb && git diff HEAD --shortstat"
	L = "!git --no-pager log --oneline --shortstat HEAD..@{u} 2>/dev/null; echo \"------------------------\"; git --no-pager log --oneline --shortstat -10"
	SL = "!git status -sb && git diff HEAD --shortstat && echo \"------------------------\" && git --no-pager log --oneline --shortstat HEAD..@{u} 2>/dev/null; echo \"------------------------\"; git --no-pager log --oneline --shortstat -10"

	# Common short forms
	co = checkout
	br = branch
	st = status
	ci = commit

	# Pretty graph log
	lg = log --graph --pretty=format:'%C(yellow)%h%Creset %C(cyan)%ad%Creset %C(auto)%d%Creset %s %C(dim white)<%an>%Creset' --abbrev-commit --date=short

	# Show last commit
	last = log -1 HEAD --stat

	# Reword the most recent commit (no editor, keep message)
	amend = commit --amend --no-edit

	# Force-push the current branch safely (errors if remote moved)
	please = push --force-with-lease

	# `git sync` — pull (rebase+autostash via global config) then push. Saves the
	# rejected-non-fast-forward → manual fetch+rebase dance when another machine
	# pushed while you were working. Conflict-free for repos with disjoint
	# per-host files (dotfiles, multi-machine notes, etc).
	sync = "!git pull && git push"
[commit]
	template = ~/.dotfiles/gitmessage
[init]
	defaultBranch = master
# Identity (name, email) for this machine's DF_IDENTITY, generated by install.sh.
[include]
	path = ~/.gitconfig.identity

# A second identity for repos whose remote is on another forge, e.g. work:
#   [includeIf "hasconfig:remote.*.url:https://*.work.example.com/**"]
#       path = ~/.dotfiles/identities/work/gitconfig
#   [includeIf "hasconfig:remote.*.url:git@*.work.example.com:*/**"]
#       path = ~/.dotfiles/identities/work/gitconfig
# In `*.work.example.com` the `*` cannot cross a `/`, so it absorbs embedded
# credentials (`user:tok@host`) but never another host's path. SCP form needs
# both `:**` (a top-level path) and `:*/**` (`group/repo`).

[include]
	path = ~/.gitconfig.local
[rerere]
	enabled = true

# Host-scoped settings (e.g. SOCKS proxies for restricted networks) are
# machine-specific — keep them in ~/.gitconfig.local, not in this universal
# config. Example:
#   [http "https://git.internal.example.com/"]
#       proxy = socks5h://127.0.0.1:1080
[pull]
	rebase = true
	autoStash = true
[fetch]
	prune = true
	pruneTags = true
[gc]
	; Never let auto-gc prune worktree admin data. Worktrees on storage that
	; is sometimes absent at gc time (unmounted /mnt/c under WSL, wiped NVMe
	; instance-store on EC2 stop/start) look dangling and get reaped mid-life,
	; stranding their branches. Cleanup is deliberate-only: an explicit
	; `git worktree prune` / `git worktree remove` ignores this setting and
	; still works. (Default is 3.months.ago.)
	worktreePruneExpire = never
[rebase]
	autoSquash = true
	updateRefs = true
	autoStash = true
[diff]
	algorithm = histogram
	colorMoved = zebra
	mnemonicPrefix = true
	renames = copies
[merge]
	conflictStyle = zdiff3
[branch]
	sort = -committerdate
[tag]
	sort = -version:refname
[column]
	ui = auto
[help]
	autocorrect = prompt
[commit]
	verbose = true
[credential "https://github.com"]
	helper = 
	helper = !\"$HOME/.dotfiles/base/git/gh-git-auth\"
[credential "https://gist.github.com"]
	helper = 
	helper = !\"$HOME/.dotfiles/base/git/gh-git-auth\"

