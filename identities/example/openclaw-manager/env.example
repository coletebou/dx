# ~/.openclaw-manager/.env  (mode 0600; loaded by the generated ~/.openclaw-manager/bin/run-gateway)
#
# The secret names of the `mine` profile (profiles/mine.json lists them and where each comes from). Nothing reads
# this file: it documents what `drover manager setup` writes. Setup creates the .env once, one line per name, each
# copied from its source file or freshly generated, never a whole env file, and it never prints a value. Values
# below are placeholders.
#
# Do NOT add other provider keys (OPENAI_API_KEY, ANTHROPIC_API_KEY, ...): they would let OpenClaw activate those
# providers and reach their APIs. Setup refuses an .env with names the profile does not use, and
# `drover manager check` flags them. To take a name from another file, change its "from" in the profile.

# The Bedrock bearer: the AWS_BEARER_TOKEN_BEDROCK line of ~/.env_secrets.
AWS_BEARER_TOKEN_BEDROCK=EXAMPLE_copy_from_env_secrets

# The key the loopback CLIProxyAPI (127.0.0.1:8317) accepts: one of the api-keys in ~/.cli-proxy-api/config.yaml,
# kept as the CLIPROXY_API_KEY line of ~/.env_secrets. The config template reads it as ${CLIPROXY_API_KEY}, so it
# never sits in openclaw.json.
CLIPROXY_API_KEY=EXAMPLE_copy_from_env_secrets

# The exa.ai search key: the EXA_API_KEY line of ~/.env_secrets. Egress: api.exa.ai only.
EXA_API_KEY=EXAMPLE_copy_from_env_secrets

# The gateway's bearer for its loopback HTTP and WebSocket surface (the Drover adapter, manager-say, the Control
# UI). Generated by setup.
OPENCLAW_GATEWAY_TOKEN=EXAMPLE_generated_by_setup

# A separate token for POST /hooks/agent and /hooks/wake (never the gateway token). Generated by setup.
OPENCLAW_HOOKS_TOKEN=EXAMPLE_generated_by_setup

# Optional: the trace export's auth header (the profile's OTEL_ENDPOINT). Setup derives it from LANGFUSE_PUBLIC_KEY
# and LANGFUSE_SECRET_KEY in ~/.env_secrets as Authorization=Basic%20<base64 of public:secret>, and adds it to an
# existing .env once both keys are there.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20EXAMPLE_base64_public_colon_secret
